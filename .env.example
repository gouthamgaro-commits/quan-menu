# Leave the Supabase values empty to run in demo mode (no login, menu kept in your browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site, used inside the QR code. Example: https://quan.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API key from https://console.anthropic.com — needed for photo reading and translation.
ANTHROPIC_API_KEY=
# Optional: override the model.
ANTHROPIC_MODEL=claude-sonnet-5-5
